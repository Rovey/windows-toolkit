<UserControl x:Class="WindowsToolkit.UI.Views.MediaConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WindowsToolkit.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000"
             Background="White">

    <d:UserControl.DataContext>
        <vm:MediaConverterViewModel/>
    </d:UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FFmpeg Status Banner -->
        <Border Grid.Row="0"
                Background="{Binding FFmpegAvailable, Converter={StaticResource BoolToColorConverter}}"
                CornerRadius="5"
                Padding="12,8"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding FFmpegStatus}"
                       Foreground="White"
                       FontSize="12"/>
        </Border>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="➕ Bestanden toevoegen"
                    Command="{Binding AddFilesCommand}"
                    Padding="14,8"
                    Background="#28A745"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#95A5A6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="📁 Map toevoegen"
                    Command="{Binding AddFolderCommand}"
                    Padding="14,8"
                    Background="#17A2B8"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#95A5A6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="🗑 Verwijderen"
                    Command="{Binding RemoveSelectedCommand}"
                    Padding="14,8"
                    Background="#DC3545"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#95A5A6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="✔ Wis voltooide"
                    Command="{Binding ClearCompletedCommand}"
                    Padding="14,8"
                    Background="#6C757D"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#95A5A6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="📂 Uitvoermap"
                    Command="{Binding OpenOutputFolderCommand}"
                    Padding="14,8"
                    Background="#6C757D"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="8,0,0,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Main Content: Job List + Settings Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Job List -->
            <Border Grid.Column="0"
                    BorderBrush="#DEE2E6"
                    BorderThickness="1"
                    CornerRadius="5"
                    Margin="0,0,12,0">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Jobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F0F0"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Status icon -->
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="{Binding StatusIcon}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>

                                            <!-- File info -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding InputPath}"/>
                                                <TextBlock Text="{Binding StatusMessage}"
                                                           FontSize="11"
                                                           Foreground="#6C757D"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Status badge -->
                                            <TextBlock Grid.Row="0" Grid.Column="2"
                                                       Text="{Binding StatusText}"
                                                       Foreground="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       Width="80"
                                                       TextAlignment="Right"/>

                                            <!-- Progress bar (only when running) -->
                                            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                         Value="{Binding Progress}"
                                                         Minimum="0" Maximum="100"
                                                         Height="4"
                                                         Margin="0,4,0,0"
                                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <TextBlock Text="Voeg videobestanden toe om te converteren"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#6C757D"
                               FontSize="14"
                               Visibility="{Binding Jobs.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Settings Panel -->
            <Border Grid.Column="1"
                    Background="#F8F9FA"
                    BorderBrush="#DEE2E6"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Instellingen"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <!-- Codec -->
                        <TextBlock Text="Videocodec" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox SelectedValue="{Binding SelectedCodec}"
                                  SelectedValuePath="Content"
                                  Padding="8,6"
                                  Margin="0,0,0,12"
                                  IsEnabled="{Binding IsNotConverting}">
                            <ComboBoxItem Content="H.265"/>
                            <ComboBoxItem Content="H.264"/>
                            <ComboBoxItem Content="AV1"/>
                        </ComboBox>

                        <!-- Format -->
                        <TextBlock Text="Uitvoerformaat" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox SelectedValue="{Binding SelectedFormat}"
                                  SelectedValuePath="Content"
                                  Padding="8,6"
                                  Margin="0,0,0,12"
                                  IsEnabled="{Binding IsNotConverting}">
                            <ComboBoxItem Content="MKV"/>
                            <ComboBoxItem Content="MP4"/>
                        </ComboBox>

                        <!-- CRF Slider -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Kwaliteit (CRF)" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Crf}" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider Value="{Binding Crf, Mode=TwoWay}"
                                Minimum="0" Maximum="51"
                                TickFrequency="1"
                                SmallChange="1"
                                LargeChange="5"
                                Margin="0,0,0,4"
                                IsEnabled="{Binding IsNotConverting}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Beter (kleiner)" FontSize="10" Foreground="#6C757D"/>
                            <TextBlock Grid.Column="1" Text="Slechter (groter)" FontSize="10" Foreground="#6C757D"/>
                        </Grid>

                        <!-- GPU preference -->
                        <CheckBox Content="GPU-encoder voorkeur"
                                  IsChecked="{Binding PreferGpu}"
                                  IsEnabled="{Binding IsNotConverting}"
                                  Margin="0,0,0,8"/>

                        <!-- Duration validation -->
                        <CheckBox Content="Duratievalidatie na encode"
                                  IsChecked="{Binding ValidateDuration}"
                                  IsEnabled="{Binding IsNotConverting}"
                                  Margin="0,0,0,15"/>

                        <!-- GPU info -->
                        <TextBlock Text="Gedetecteerde GPU-encoder:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Border Background="White"
                                BorderBrush="#DEE2E6"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,6">
                            <TextBlock Text="{Binding DetectedGpu}"
                                       FontSize="11"
                                       Foreground="#495057"
                                       TextWrapping="Wrap"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Progress + Actions Bar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Convert button -->
            <Button Grid.Column="0"
                    Content="▶ Alles converteren"
                    Command="{Binding ConvertAllCommand}"
                    Padding="18,10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#28A745"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#95A5A6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Cancel button -->
            <Button Grid.Column="1"
                    Content="⏹ Annuleren"
                    Command="{Binding CancelCommand}"
                    Padding="14,10"
                    FontSize="14"
                    Background="#DC3545"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,12,0"
                    Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Total progress bar -->
            <ProgressBar Grid.Column="2"
                         Value="{Binding TotalProgress}"
                         Minimum="0" Maximum="100"
                         Height="22"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"/>

            <!-- Progress % -->
            <TextBlock Grid.Column="3"
                       Text="{Binding TotalProgress, StringFormat={}{0}%}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Width="40"
                       TextAlignment="Right"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="4"
                Background="#F8F9FA"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12,8"
                Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="#495057"/>
        </Border>
    </Grid>
</UserControl>
